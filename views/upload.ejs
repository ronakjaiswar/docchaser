<!DOCTYPE html>
<html>
<head>
  <title>Upload Documents</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="max-w-md mx-auto px-4 py-8">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800">DocChaser</h1>
      <p class="text-sm text-gray-500 mt-1">Secure document collection</p>
    </div>

    <div class="space-y-5 rounded-lg bg-white p-5 shadow-sm sm:p-6">
      <% if (error) { %>
        <div class="rounded border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"><%= error %></div>
      <% } %>

      <% if (firmName) { %>
        <section aria-labelledby="request-status-heading">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase text-gray-500">Document request</p>
              <h2 id="request-status-heading" class="mt-1 text-lg font-bold text-gray-800"><%= firmName %></h2>
            </div>
            <% if (documents.length > 0) { %>
              <span class="shrink-0 rounded bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-800">Uploaded</span>
            <% } else { %>
              <span class="shrink-0 rounded bg-yellow-100 px-2.5 py-1 text-xs font-semibold text-yellow-800">Pending</span>
            <% } %>
          </div>
          <p class="mt-2 text-sm text-gray-600">
            <% if (documents.length > 0) { %>
              <%= documents.length %> <%= documents.length === 1 ? 'file is' : 'files are' %> saved in the firm workspace.
            <% } else { %>
              No files have been uploaded for this request yet.
            <% } %>
          </p>
          <% if (requestCreatedAt) { %>
            <p class="mt-1 text-xs text-gray-500">Requested <%= new Date(requestCreatedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> · No deadline set</p>
          <% } %>
          <p class="mt-2 text-xs text-gray-500">Upload confirms delivery to the firm's workspace; review or approval status is not tracked here.</p>
        </section>

        <% if (success) { %>
          <div class="rounded border border-green-200 bg-green-50 p-3 text-sm text-green-800" role="status">
            Documents submitted. You can upload additional files below if anything is still pending.
          </div>
        <% } %>

        <% if (documents.length > 0) { %>
          <section class="border-t border-gray-200 pt-4" aria-labelledby="uploaded-files-heading">
            <h3 id="uploaded-files-heading" class="text-sm font-semibold text-gray-800">Files on this request</h3>
            <ul class="mt-3 divide-y divide-gray-100">
              <% documents.forEach(document => { %>
                <li class="flex items-start justify-between gap-3 py-3">
                  <div class="min-w-0">
                    <p class="break-all text-sm font-medium text-gray-800"><%= document.file_name %></p>
                    <p class="mt-1 text-xs text-gray-500"><%= document.uploaded_at ? new Date(document.uploaded_at).toLocaleDateString('en-IN') : '' %></p>
                    <% if (document.extraction_status === 'completed') { %>
                      <p class="mt-1 text-xs text-gray-500">Analyzed</p>
                    <% } else if (document.extraction_status === 'processing' || document.extraction_status === 'retry_pending' || document.extraction_status === 'failed') { %>
                      <p class="mt-1 text-xs text-gray-500">Reviewing...</p>
                    <% } %>
                  </div>
                  <span class="inline-flex shrink-0 items-center gap-1 rounded bg-green-100 px-2 py-1 text-xs font-medium text-green-800">✓ Saved</span>
                </li>
              <% }) %>
            </ul>
          </section>

          <a href="https://wa.me/?text=<%= encodeURIComponent('Hi ' + firmName + ', I uploaded ' + documents.length + ' document(s) for my request. Could you let me know if anything is still pending?') %>" target="_blank" rel="noopener noreferrer" class="block w-full rounded border border-green-700 px-4 py-2.5 text-center text-sm font-medium text-green-800 hover:bg-green-50">
            Follow up with <%= firmName %> on WhatsApp
          </a>
        <% } %>

        <section class="border-t border-gray-200 pt-4">
        <h2 class="text-lg font-bold text-gray-800 mb-1">Upload Documents</h2>
        <p class="text-sm text-gray-600 mb-4">
          Add files to this request
        </p>

        <form id="upload-form" action="/u/<%= token %>/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Select files (PDF, JPG, PNG)
            </label>
            <input type="file" name="documents" multiple required
              accept=".pdf,.jpg,.jpeg,.png"
              class="w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
            <p class="text-xs text-gray-500 mt-1">Multiple files select kar sakte ho. Max 10MB per file.</p>
          </div>

          <button type="submit"
            class="w-full bg-blue-600 text-white py-3 rounded hover:bg-blue-700 font-medium">
            Upload Documents
          </button>
        </form>

        <p class="text-xs text-gray-400 text-center mt-4">
          🔒 Your documents are securely stored
        </p>
        </section>
      <% } %>
    </div>
  </div>
  <div id="ai-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-gray-950/80 px-6 text-center text-white" role="status" aria-live="polite" aria-hidden="true">
    <div>
      <div class="mb-5 animate-bounce text-6xl" aria-hidden="true">🤖</div>
      <div class="mx-auto mb-5 h-12 w-12 animate-spin rounded-full border-4 border-white/25 border-t-white"></div>
      <h2 class="text-xl font-semibold">AI Analyzing Documents...</h2>
      <p class="mt-2 max-w-sm text-sm text-gray-200">Extracting invoice details, GSTIN, amount</p>
    </div>
  </div>
  <script>
    const uploadForm = document.getElementById('upload-form');
    if (uploadForm) {
      uploadForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const overlay = document.getElementById('ai-overlay');
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        overlay.setAttribute('aria-hidden', 'false');
        window.setTimeout(() => uploadForm.submit(), 100);
      });
    }
  </script>
</body>
</html>